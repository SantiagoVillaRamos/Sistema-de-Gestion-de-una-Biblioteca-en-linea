# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ENVIRONMENT
ENVIRONMENT=development

# DATABASE CONFIGURATION
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=library_db
POSTGRES_USER=postgres

# 🔒 SECURITY: Use a strong password!
# In production, this MUST be set (no default)
POSTGRES_PASSWORD=your_secure_database_password_here

# JWT CONFIGURATION
# 🔒 SECURITY: Generate a secure random key with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# In production, this MUST be set (no default)
# NEVER use the same key across environments!
JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token expiration in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SEED DATA (Development/Staging Only)
# 🔒 SECURITY: These passwords are used by seed_data.py
# Change these immediately after seeding!
# DO NOT run seed script in production!
SEED_ADMIN_PASSWORD=Admin@1234
SEED_USER_PASSWORD=Password123!

# SECURITY NOTES
# 1. Never commit .env file to git (it's in .gitignore)
# 2. Use different secrets for each environment
# 3. Rotate secrets regularly (every 90 days for JWT, 180 days for DB)
# 4. Generate strong random secrets, never use predictable values
# 5. In production, set ENVIRONMENT=production to enforce secret requirements
